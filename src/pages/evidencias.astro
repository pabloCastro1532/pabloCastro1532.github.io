								<div class="mockup-code bg-[#1a1b26] text-[#c0caf5] border border-neutral-800 text-xs font-mono">
									<pre class="px-5 py-2"><code><span class="text-[#bb9af7]">DECLARE</span>
    exc_miprimeraexception <span class="text-[#bb9af7]">EXCEPTION</span>;
    result                 <span class="text-[#e0af68]">NUMBER</span>;
<span class="text-[#bb9af7]">BEGIN</span>
    <span class="text-[#bb9af7]">IF</span> 1 = 0 <span class="text-[#bb9af7]">THEN</span>
        <span class="text-[#bb9af7]">RAISE</span> exc_miprimeraexception;
    <span class="text-[#bb9af7]">ELSE</span>
        <span class="text-[#bb9af7]">SELECT</span> 1 / 0 <span class="text-[#bb9af7]">INTO</span> result <span class="text-[#bb9af7]">FROM</span> dual;
    <span class="text-[#bb9af7]">END IF;</span>
<span class="text-[#bb9af7]">EXCEPTION</span>
    <span class="text-[#bb9af7]">WHEN</span> exc_miprimeraexception <span class="text-[#bb9af7]">THEN</span>
        dbms_output.put_line(<span class="text-[#9ece6a]">'Penalti para el yuyu'</span>);
    <span class="text-[#bb9af7]">WHEN</span> <span class="text-[#bb9af7]">OTHERS</span> <span class="text-[#bb9af7]">THEN</span>
        <span class="text-[#e0af68]">raise_application_error</span>(-20455, <span class="text-[#9ece6a]">'Les dije que pongan atención'</span>);
<span class="text-[#bb9af7]">END;</span>
/</code></pre>
