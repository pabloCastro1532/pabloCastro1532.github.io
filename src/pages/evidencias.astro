<script>
	// Funcionalidad interactiva del lado del cliente
	// Se asocia al evento 'astro:page-load' para dar soporte correcto 
	// al enrutador nativo de Astro con View Transitions.
	function initInteractiveElements() {
		// 1. Selector de Pestañas Principales (SQL, PL/SQL, NoSQL)
		const tabs = document.querySelectorAll('[data-tab]');
		const panels = document.querySelectorAll('[data-panel]');

		tabs.forEach(tab => {
			tab.addEventListener('click', () => {
				const target = tab.getAttribute('data-tab');

				// Actualizar estado de las pestañas
				tabs.forEach(t => {
					t.classList.remove('tab-active', 'bg-primary', 'text-primary-content', 'shadow');
					t.classList.add('opacity-60', 'text-base-content');
				});
				tab.classList.add('tab-active', 'bg-primary', 'text-primary-content', 'shadow');
				tab.classList.remove('opacity-60', 'text-base-content');

				// Actualizar visibilidad de los paneles
				panels.forEach(panel => {
					if (panel.getAttribute('data-panel') === target) {
						panel.classList.remove('hidden');
						panel.classList.add('block');
					} else {
						panel.classList.remove('block');
						panel.classList.add('hidden');
					}
				});
			});
		});

		// 2. Selector de Colecciones de MongoDB (NoSQL)
		const colTabs = document.querySelectorAll('.collection-tab');
		const colDescs = document.querySelectorAll('.collection-desc');
		const colCodes = document.querySelectorAll('.collection-code');

		colTabs.forEach(tab => {
			tab.addEventListener('click', () => {
				const colName = tab.getAttribute('data-collection');

				// Cambiar estado activo del botón
				colTabs.forEach(ct => ct.classList.remove('btn-active'));
				tab.classList.add('btn-active');

				// Mostrar descripción correspondiente
				colDescs.forEach(desc => {
					if (desc.id === `col-desc-${colName}`) {
						desc.classList.remove('hidden');
						desc.classList.add('block');
					} else {
						desc.classList.remove('block');
						desc.classList.add('hidden');
					}
				});

				// Mostrar bloque de código correspondiente
				colCodes.forEach(code => {
					if (code.id === `col-code-${colName}`) {
						code.classList.remove('hidden');
						code.classList.add('block');
					} else {
						code.classList.remove('block');
						code.classList.add('hidden');
					}
				});
			});
		});
	}

	// Inicialización inmediata y en transiciones de página
	initInteractiveElements();
	document.addEventListener('astro:page-load', initInteractiveElements);
</script>