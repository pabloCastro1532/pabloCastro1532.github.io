<span class="text-[#bb9af7]">BEGIN</span>
    <span class="text-[#bb9af7]">OPEN</span>  C_MYEMPLOYEES2(&user);
    <span class="text-[#bb9af7]">FETCH</span> C_MYEMPLOYEES2 <span class="text-[#bb9af7]">INTO</span> vv_firtsName, vn_departmentID;
